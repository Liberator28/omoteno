# Was erzeugt werden kann, gehört nicht in die Versionsgeschichte.
# Sonst zeigt jeder Diff tausende Zeilen, die niemand gelesen hat.
dist/
dist-newsletter/

# Arbeitsreste
.DS_Store
*.tmp

# Der ausgelieferte Ordner. Wird von bauen.js aus dem Verzeichnis
# zusammengestellt und bei jeder Auslieferung neu gebaut.
oeffentlich/

# Zugangsdaten. .mcp.json trägt NUR den Platzhalter
# ${SUPABASE_ACCESS_TOKEN}; der Wert selbst gehört hier hinein oder in
# die Umgebung — nie in eine Datei, die mitgeht. Ein Token in der
# Versionsgeschichte bleibt dort, auch wenn man ihn später löscht, und
# Netlify klont das Verzeichnis bei jedem Bau mit.
.env
.env.local
