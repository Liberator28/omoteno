# ═══════════════════════════════════════════════════════════════
#  KOPFZEILEN
#
#  Wird von bauen.js nach oeffentlich/ kopiert. Netlify liest die
#  Datei von dort.
#
#  Jede Zeile hier ist eine Antwort auf eine Frage, die ein Kunde
#  oder sein Steuerberater irgendwann stellt. Sie sind billig und
#  wirken sofort — im Gegensatz zu fast allem anderen in dieser
#  Kategorie.
# ═══════════════════════════════════════════════════════════════

/*
  # Niemand darf unsere Seiten in einen fremden Rahmen setzen. Sonst
  # baut jemand eine Seite, die aussieht wie seine, und darin liegt
  # unser Board — samt Anmeldung.
  X-Frame-Options: DENY
  # Content-Security-Policy (08.10., Sicherheitssystem): Was eine
  # Seite laden und wohin sie senden darf. Wirkt vor allem gegen das,
  # was nach einer eingeschleusten Zeile kommt: Kein Skript von einem
  # fremden Server, keine Daten an einen fremden Server (connect-src),
  # kein Formular an fremde Adressen, kein <base>-Umbiegen, keine
  # Plugins, kein fremder Rahmen um uns.
  # 'unsafe-inline' für Skripte ist ehrlich benannt: Die Seiten sind
  # Einzeldateien mit eingebettetem Skript — das ist die Bauart, nicht
  # ein Versehen. connect-src nennt NUR das eigene Projekt (nicht *.supabase.co,
  # 19.10.): Sonst schickte ein eingeschleustes Skript alles, was es liest,
  # an ein Supabase-Projekt des Angreifers — erlaubt wäre es gewesen.
  # Fotos dürfen von jeder https-Adresse kommen, weil
  # der Wirt eigene Bildadressen eintragen darf.
  # Gemessen: pruef-sicherheit.js lädt jede Seite mit genau dieser
  # Kopfzeile und hört auf securitypolicyviolation.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://omoteno.de; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https://omoteno.de; connect-src 'self' https://quxwweuvdqtjsdwgjdrh.supabase.co wss://quxwweuvdqtjsdwgjdrh.supabase.co https://omoteno.de https://openplzapi.org; media-src 'self' data: blob: https:; worker-src 'self' blob:; frame-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

  # Nur noch https, auch für jede Kundenadresse unter omoteno.de, ein
  # Jahr lang. Ein Angreifer im Café-WLAN kann den Gast dann nicht auf
  # eine unverschlüsselte Fassung umlenken.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Kein Erraten des Dateityps. Ohne das kann eine hochgeladene
  # Datei je nach Inhalt als Skript ausgeführt werden.
  X-Content-Type-Options: nosniff

  # Beim Klick nach draußen geht der Pfad NICHT mit. Ein Gast, der
  # aus seinem Bestellpass heraus auf eine Karte klickt, würde sonst
  # seine Bestellnummer an den Kartendienst weiterreichen.
  Referrer-Policy: strict-origin-when-cross-origin

  # Kamera, Mikrofon und Ort braucht keine dieser Seiten.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# ── Was der Browser aufheben darf ──────────────────────────────
# Die Seiten selbst NICHT lange: Wer sein Markenblatt ändert, will
# es sehen. „must-revalidate" heißt: nachfragen, aber die alte
# Fassung behalten, wenn sich nichts geändert hat — das kostet eine
# Anfrage und keinen Neuaufbau.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Der Hub eines Gastes darf kurz stehen bleiben. Er wird im Betrieb
# hundertfach am Abend geöffnet, und eine Karte ändert sich nicht
# im Minutentakt. Fünf Minuten ist der Kompromiss zwischen „lädt
# sofort" und „zeigt den heutigen Stand".
/h/*
  Cache-Control: public, max-age=300, must-revalidate

# Das Board und die Küche NIE aufheben. Wer am Pass steht, muss den
# echten Stand sehen, nicht den von vorhin.
/admin.html
  Cache-Control: no-store
/kueche.html
  Cache-Control: no-store
/konto.html
  Cache-Control: no-store
/einkauf.html
  Cache-Control: no-store

# Bewegte Zeichen: Der Hub holt sie von https://omoteno.de/emoji/,
# auch wenn er unter choco-lamour.omoteno.de läuft — das ist eine
# andere Herkunft, und ohne diesen Kopf verweigert der Browser dem
# fetch() die Antwort. Nur lesen, keine Anmeldedaten: „*" ist hier
# richtig, es sind öffentliche Bilder.
# Der Inhalt einer Datei ändert sich nie — sie heißt nach ihrem
# Codepunkt, der Abspieler nach seiner Version. Deshalb ein Jahr.
/emoji/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

# Die wählbaren Schriften (Board → Startseite → Schrift). Derselbe
# Grund wie oben: Der Hub holt sie von omoteno.de, auch wenn er unter
# choco-lamour.omoteno.de läuft — ohne diesen Kopf lädt der Browser
# eine Schrift von fremder Herkunft gar nicht erst.
/schriften/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

# Der Service Worker wird bei jeder Auslieferung neu geprüft. Hielte
# der Browser ihn fest, liefe nach einer Änderung tagelang die alte
# Fassung weiter — und ein Service Worker, den man nicht mehr
# austauschen kann, ist der unangenehmste Fehler dieser Bauart.
# Selbst ausgelieferte Bibliotheken: Die Version steht im Dateinamen,
# der Inhalt ändert sich also nie. Ein Jahr. Der CORS-Kopf (10.10.):
# Der Hub holt den QR-Erzeuger mit integrity von omoteno.de, auch unter
# einer eigenen Adresse — ohne ihn verweigert der Browser die Datei.
/lib/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
